<form id="auth-form" onsubmit={{action (if this.isOIDC "startOIDCAuth" @onSubmit) (hash role=this.roleName jwt=this.jwt)}}>
  {{! Patty: Role input is hidden AND unbound — default_role (openbao) is always
    used. Never bind browser input here: autofill can write junk into the hidden
    field, which the backend rejects with "role could not be found". }}
  <div class="field" style="display:none" aria-hidden="true">
    <label for="role" class="is-label">Role</label>
    <div class="control">
      <input
        value=""
        placeholder="Default"
        autocomplete="off"
        spellcheck="false"
        readonly
        tabindex="-1"
        name="role"
        id="role"
        class="input"
        type="text"
        data-test-role
      />
    </div>
    <AlertInline
      @sizeSmall={{true}}
      @paddingTop={{true}}
      @type="info"
      @message="Leave blank to sign in with the default role if one is configured"
    />
  </div>
  {{#unless this.isOIDC}}
    <div class="field">
      <label for="token" class="is-label">JWT Token</label>
      <div class="control">
        <Input
          @type="password"
          @value={{this.jwt}}
          name="jwt"
          class="input"
          autocomplete="off"
          spellcheck="false"
          data-test-jwt={{true}}
        />
      </div>
    </div>
  {{/unless}}
  {{#unless this.isOIDC}}
    <div data-test-yield-content>
      {{yield}}
    </div>
  {{/unless}}
  <button
    data-test-auth-submit={{true}}
    type="submit"
    disabled={{@disabled}}
    class="button is-primary is-fullwidth {{if @disabled 'is-loading'}}"
    id="auth-submit"
  >
    {{#if this.isOIDC}}
      Login with Patty
    {{else}}
      Sign In
    {{/if}}
  </button>
</form>